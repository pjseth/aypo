# ─────────────────────────────────────────────────────────────────────────────
# AYPO — environment configuration
# Copy to .env and fill in. NEVER commit .env. No credential is hard-coded in
# source; every provider reads from here and degrades gracefully when absent.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core AI ──────────────────────────────────────────────────────────────────
# Multimodal analysis, research agent, finding generation, Ask-the-Data.
ANTHROPIC_API_KEY=
AYPO_LLM_MODEL=claude-opus-5
AYPO_LLM_FALLBACK_MODEL=claude-opus-4-8
# High-volume per-video extraction only. Judgement-heavy stages (research
# planning, findings, Ask-the-Data) always use AYPO_LLM_MODEL.
AYPO_ANALYSIS_MODEL=claude-sonnet-5
# Effort for the high-volume per-video analysis pass (low|medium|high|xhigh|max)
AYPO_ANALYSIS_EFFORT=medium
# Effort for research planning, finding generation and Ask-the-Data
AYPO_REASONING_EFFORT=high

# Embeddings (Anthropic has no embeddings API). 1536 dims keeps pgvector HNSW
# usable (HNSW caps at 2000 dims).
OPENAI_API_KEY=
AYPO_EMBEDDING_PROVIDER=openai
AYPO_EMBEDDING_MODEL=text-embedding-3-large
AYPO_EMBEDDING_DIMENSIONS=1536

# Speech-to-text. whisper-1 auto-detects language and tolerates code-switching,
# which matters for Taglish audio. Do not pin a language.
AYPO_TRANSCRIPTION_PROVIDER=openai
AYPO_TRANSCRIPTION_MODEL=whisper-1

# Optional alternate providers (fallbacks / native-video analysis path)
GEMINI_API_KEY=
JINA_API_KEY=

# ── Collection: managed public-data layer ────────────────────────────────────
# REQUIRED for TikTok / Instagram / Facebook / Shopee / Lazada collection.
# Without it those collectors report unavailable and the research run continues
# on the remaining sources (see brief §7).
APIFY_TOKEN=
# Actor ids are configurable because third-party actors change without notice.
APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper
APIFY_FACEBOOK_ACTOR=apify~facebook-posts-scraper
APIFY_SHOPEE_ACTOR=gio21~shopee-scraper
APIFY_SHOPEE_COUNTRY=PH
APIFY_SHOPEE_REVIEWS_ACTOR=zen-studio~shopee-product-reviews-scraper
APIFY_LAZADA_ACTOR=fatihtahta~lazada-scraper
# lowercase on purpose: this actor's country enum differs in case from Shopee's
APIFY_LAZADA_COUNTRY=ph
APIFY_DEFAULT_TIMEOUT_SECS=300
APIFY_MAX_CONCURRENT_RUNS=4

# ── Collection: official APIs ────────────────────────────────────────────────
# REQUIRED for YouTube collection. Absent -> YouTube reports unavailable.
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=PH
YOUTUBE_RELEVANCE_LANGUAGE=en

# ── Collection: web / search discovery ───────────────────────────────────────
# Used for public-web discovery and as a partial fallback when a platform
# collector is unavailable.
SERPER_API_KEY=
AYPO_WEBSEARCH_PROVIDER=serper

# ── Database ─────────────────────────────────────────────────────────────────
# Direct Postgres connection used by the API and workers (asyncpg).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aypo
# Supabase (auth + storage + client-side reads)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Object storage (frames, audio, thumbnails) ───────────────────────────────
AYPO_STORAGE_BACKEND=local
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Local filesystem root used when AYPO_STORAGE_BACKEND=local
AYPO_LOCAL_STORAGE_ROOT=.media

# ── Research run defaults (budget caps a run; brief §26) ─────────────────────
AYPO_MAX_COLLECTION_UNITS=4000
AYPO_MAX_LLM_USD=120
AYPO_MAX_WALLCLOCK_MINUTES=180
AYPO_MAX_ITERATIONS=8

# ── Media processing ─────────────────────────────────────────────────────────
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
AYPO_MAX_VIDEO_DOWNLOAD_MB=120

# ── Runtime ──────────────────────────────────────────────────────────────────
AYPO_ENV=development
AYPO_LOG_LEVEL=INFO
AYPO_API_PORT=8000
AYPO_WORKER_CONCURRENCY=4
# Frontend -> backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
